# OBIX 360 / Orderflow environment template.
#
# API:  copy the "API" block to packages/api/.env.local   (also read: packages/api/.env, ../../.env.local, ../../.env)
# Web:  copy the "WEB" block to apps/web/.env.local
# Never commit real values. Anything marked REQUIRED must be set in production.

# =============================== API ===============================

# --- Server ---
# PORT is optional: unset means 4000 in development and 3001 in production.
# PORT=4000
# Number of reverse proxies in front of the API (Apache/Nginx = 1, add 1 for a CDN).
# Used for client IPs and rate limiting. Never set it to "true".
TRUST_PROXY_HOPS=1
# Comma-separated browser origins allowed by CORS. Unset uses the built-in list in src/main.ts.
# ALLOWED_ORIGINS=https://obix360.com,https://www.obix360.com

# --- Auth --- REQUIRED
# Long random string. Signs login tokens.
JWT_SECRET=change-me-to-a-long-random-value
# Encrypts stored staff/kitchen/salesman passwords. If unset it falls back to JWT_SECRET,
# so set it to the CURRENT JWT_SECRET before you ever rotate JWT_SECRET, or those passwords become unreadable.
# CREDENTIAL_ENCRYPTION_KEY=
# Local development only: return OTP codes in the API response when email sending fails. Keep false elsewhere.
ALLOW_OTP_DEV_BYPASS=false
# Google sign-in (the web equivalent is NEXT_PUBLIC_GOOGLE_CLIENT_ID).
# GOOGLE_CLIENT_ID=

# --- Database ---
# Managed Postgres: set DATABASE_URL (SSL is required). Migrations run on startup.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# Local Postgres: leave DATABASE_URL unset and use these (defaults shown).
DB_HOST=localhost
DB_PORT=5432
DB_USER=orderflow_user
DB_PASSWORD=password123
DB_NAME=orderflow_dev
# Print every SQL query (local debugging only; logs contain personal data).
# DB_LOG_QUERIES=false

# --- Subscriptions ---
# Set to "false" to switch plan enforcement off without a deploy (emergency kill switch).
# PAYWALL_ENFORCED=true

# --- WhatsApp (Evolution API) ---
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=
# REQUIRED in production: shared secret the WhatsApp gateway sends to /api/whatsapp/webhook.
# WHATSAPP_WEBHOOK_SECRET=change-me-to-a-long-random-value
# Public URL the gateway should call. Defaults to https://obix360.com/api/whatsapp/webhook.
# WHATSAPP_WEBHOOK_URL=

# --- AI (Google Gemini) ---
# GEMINI_API_KEY=
# Optional second key to spread usage.
# GEMINI_API_KEY_2=

# --- Email ---
# Direct SMTP:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# Or send through the apps/mailer function (for hosts that block SMTP ports):
# EMAIL_PROXY_URL=
# EMAIL_PROXY_SECRET=

# --- Push notifications ---
# The whole Firebase service-account JSON as one line. Unset means push is skipped.
# FIREBASE_SERVICE_ACCOUNT=

# --- File storage (S3-compatible: Neon Object Storage) ---
# The AWS SDK reads these. Buckets: product-images, prescriptions, invoice-scans, app-releases.
# AWS_ENDPOINT_URL_S3=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# --- PDF invoices (Puppeteer) ---
# Path to a Chromium binary when the bundled one is not used (containers/servers).
# PUPPETEER_EXECUTABLE_PATH=

# --- Optional features ---
# Static key for the read-only Google Sheets order feed (/api/sheets-sync). 24+ characters. Unset disables the endpoint.
# SHEETS_SYNC_KEY=
# Used once by `npm run bootstrap:admin --workspace=api` to create the first super admin.
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_NAME=

# ================================ WEB ================================

# Base URL of the API as seen by the browser/app. Local development: http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Base URL of the mailer function. Defaults to http://localhost:3010.
# NEXT_PUBLIC_MAILER_URL=
# Web-push public key (VAPID), if push from the browser is used.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# "direct" for APK downloads, set to the store name for store builds so the app skips self-update.
# NEXT_PUBLIC_DISTRIBUTION_CHANNEL=direct
